# Cadena de conexión de MongoDB Atlas (reemplazar usuario, password y cluster)
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=huellitas_cerca_db

# Seguridad JWT (cambiar en producción por una clave larga aleatoria)
JWT_SECRET=clave_super_secreta_huellitas_2026_cambiar
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Configuración general
APP_NAME=Huellitas Cerca
CORS_ORIGINS=*
